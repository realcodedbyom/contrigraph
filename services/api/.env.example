SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-public-key
AUTH_MODE=clerk
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
CLERK_SECRET_KEY=sk_test_your_server_only_key
APP_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
ENABLE_SANDBOX=true
COOKIE_SECURE=false
# Optional server-only Supabase Postgres connection (with sslmode=require):
DATABASE_URL=
# Use the same strong random server-only key across API workers to share preview signatures.
# Blank uses an ephemeral process key; restarting invalidates outstanding previews.
PREVIEW_SIGNING_KEY=
